### Uses the REST Client extension (humao.rest-client).
### Click "Send Request" above a request. All calls go through the API Gateway (port 8080).

############ USER SERVICE ############

### 1. Register a new customer
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "test@example.com",
  "password": "secret123"
}

### 2. Login (copy the "token" from the response)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "secret123"
}

### 3. Get my profile (paste your token after "Bearer ")
GET http://localhost:8080/api/users/me
Authorization: Bearer PASTE_TOKEN_HERE

### 4. Login as the default admin (copy the token, you need it for the admin requests below)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "admin@foodrush.com",
  "password": "Admin@123"
}

### 5. List all users (ADMIN token only, a customer token gets 403)
GET http://localhost:8080/api/users
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

############ RESTAURANT SERVICE ############

### 6. List all restaurants (public, no token needed)
GET http://localhost:8080/api/restaurants

### 7. Filter by cuisine (public)
GET http://localhost:8080/api/restaurants?cuisine=Indian

### 8. Get one restaurant (public)
GET http://localhost:8080/api/restaurants/1

### 9. Get the menu of a restaurant (public)
GET http://localhost:8080/api/restaurants/1/menu

### 10. Get one menu item by id (public, the order service will use this later)
GET http://localhost:8080/api/restaurants/menu-items/1

### 11. Create a restaurant (ADMIN token needed)
POST http://localhost:8080/api/restaurants
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE
Content-Type: application/json

{
  "name": "Burger Hub",
  "description": "Juicy burgers and fries",
  "address": "Baner, Pune",
  "cuisine": "American"
}

### 12. Add a menu item (ADMIN token needed, change the 3 to your new restaurant id)
POST http://localhost:8080/api/restaurants/3/menu
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE
Content-Type: application/json

{
  "name": "Cheese Burger",
  "description": "Double cheese",
  "price": 150.00
}

### 13. Update a menu item (ADMIN token needed)
PUT http://localhost:8080/api/restaurants/3/menu/6
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE
Content-Type: application/json

{
  "name": "Cheese Burger",
  "description": "Double cheese, extra crispy",
  "price": 165.00,
  "available": true
}

### 14. Try creating a restaurant with a CUSTOMER token (should return 403)
POST http://localhost:8080/api/restaurants
Authorization: Bearer PASTE_CUSTOMER_TOKEN_HERE
Content-Type: application/json

{
  "name": "Not Allowed",
  "address": "Nowhere"
}

### 15. Delete a menu item (ADMIN token needed)
DELETE http://localhost:8080/api/restaurants/3/menu/6
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### Eureka registry
GET http://localhost:8761/eureka/apps
Accept: application/json

############ ORDER SERVICE ############

### 16. Place an order (any logged-in token; change menuItemId values to real ids from request 9)
POST http://localhost:8080/api/orders
Authorization: Bearer eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiJ0ZXN0QGV4YW1wbGUuY29tIiwicm9sZSI6IkNVU1RPTUVSIiwidXNlcklkIjoyLCJpYXQiOjE3OTA2NTY2MzIsImV4cCI6MTc5MDc0MzAzMn0.eg0D2gfYgq-VHduUIZeD3VlsWtLL3wqXs53PHFU4c7FPPrkBiVnSwDYanYR9dpjT
Content-Type: application/json

{
  "restaurantId": 1,
  "deliveryAddress": "221B Baker Street, Pune",
  "items": [
    { "menuItemId": 1, "quantity": 2 },
    { "menuItemId": 2, "quantity": 1 }
  ]
}

### 17. My orders
GET http://localhost:8080/api/orders/my
Authorization: Bearer eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiJ0ZXN0QGV4YW1wbGUuY29tIiwicm9sZSI6IkNVU1RPTUVSIiwidXNlcklkIjoyLCJpYXQiOjE3OTA2NTY2MzIsImV4cCI6MTc5MDc0MzAzMn0.eg0D2gfYgq-VHduUIZeD3VlsWtLL3wqXs53PHFU4c7FPPrkBiVnSwDYanYR9dpjT

### 18. Get one order by id (owner or admin)
GET http://localhost:8080/api/orders/1
Authorization: Bearer PASTE_TOKEN_HERE

### 19. All orders (ADMIN only)
GET http://localhost:8080/api/orders
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### 20. Update order status (ADMIN only)
PUT http://localhost:8080/api/orders/1/status
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE
Content-Type: application/json

{
  "status": "CONFIRMED"
}

### 21. Try placing an order with a menu item that does not exist (should fail cleanly)
POST http://localhost:8080/api/orders
Authorization: Bearer eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiJ0ZXN0QGV4YW1wbGUuY29tIiwicm9sZSI6IkNVU1RPTUVSIiwidXNlcklkIjoyLCJpYXQiOjE3OTA2NTY2MzIsImV4cCI6MTc5MDc0MzAzMn0.eg0D2gfYgq-VHduUIZeD3VlsWtLL3wqXs53PHFU4c7FPPrkBiVnSwDYanYR9dpjT
Content-Type: application/json

{
  "restaurantId": 1,
  "deliveryAddress": "Test address",
  "items": [
    { "menuItemId": 9999, "quantity": 1 }
  ]
}
